{
    "name": "yasukei/dmm-api-client-php",
    "description": "DMM API client for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "yasukei"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cuyz/valinor": "^2.6"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DmmApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
