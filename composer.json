{
    "name": "yasukei/dmm-api-client-php",
    "description": "DMM API client for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "yasukei"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cuyz/valinor": "^2.6",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8.2",
        "pestphp/pest": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.0"
    },
    "bin": [
        "bin/dmm"
    ],
    "autoload": {
        "psr-4": {
            "DmmApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "DmmApiClient\\LiveProbe\\": "tools/live-probe/src/"
        }
    },
    "scripts": {
        "test": "pest",
        "probe": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/live-probe/probe.php"
        ],
        "stan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
